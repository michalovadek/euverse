# Note: .Renviron IS committed in this repo (it only carries the renv sandbox
# toggle — no secrets). If you ever add API keys, put them in .Renviron.local
# (which is gitignored below) so they don't ship to the public repo.
.Renviron.local

# --- renv ---------------------------------------------------------------------
# renv/activate.R and renv/settings.json ARE committed; renv writes its own
# renv/.gitignore for the rest.
renv/library/
renv/python/
renv/staging/
renv/local/
renv/cellar/
renv/sandbox/

# --- Python / uv --------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# --- Data ---------------------------------------------------------------------
# data-manual/ is committed (curated by hand).
# data-apis/ defaults to committed parquet snapshots (small); exclude raw API
# dumps and CSV/TSV bulk fallbacks.
# data-external/ is committed but each file MUST have a .source.txt sidecar.
# data-final/ is committed (cross-cutting joins / derived data shared by trackers).
data-apis/*.csv
data-apis/*.tsv
data-apis/raw/

# data-external bulky raw downloads — exceed GitHub's 100MB hard limit or
# the project's <5MB soft target. Developers obtain them locally per the
# instructions in each subfolder's _SOURCE.md. When a tracker consumes one,
# it converts to a small parquet/CSV that IS committed (typically under
# data-final/ for joined data, or data-apis/ if API-derived).
data-external/euprops/*.dta
data-external/euplex/*.csv
data-external/parlgov/*.db
data-external/parlgov/parlgov-stable.xlsx
data-external/parlgov/view_cabinet.csv
data-external/parlgov/view_election.csv

# --- OS / editor --------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~
